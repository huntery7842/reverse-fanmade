<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ReVerse.Relay.Desktop.MainWindow"
        Title="ReVerse Relay"
        Icon="/Assets/relay-icon.png"
        Width="620"
        Height="900"
        MinWidth="460"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="32,28,32,32" Spacing="22" MaxWidth="600">
        <Grid ColumnDefinitions="52,*" ColumnSpacing="14">
          <Border Width="52" Height="52" CornerRadius="16" Background="#4FD1C5">
            <TextBlock Text="R" Foreground="#071016" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="ReVerse Relay" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Private relay for your community backend" FontSize="13" Foreground="#9FB0C8" />
          </StackPanel>
        </Grid>

        <Border Background="#111C2E" BorderBrush="#293750" BorderThickness="1" CornerRadius="18" Padding="22">
          <StackPanel Spacing="16">
            <StackPanel Spacing="0">
              <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#9FB0C8" />
              <TextBox x:Name="UsernameEntry" Classes="form-field" PlaceholderText="Choose a display name" MaxLength="64" />
            </StackPanel>

            <StackPanel Spacing="0">
              <TextBlock Text="SECRET KEY" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#9FB0C8" />
              <TextBox x:Name="SecretEntry" Classes="form-field" PlaceholderText="Enter your shared secret" PasswordChar="●" MaxLength="1024" />
              <TextBlock Text="The secret is used for sign-in and is never saved." Margin="2,7,0,0" FontSize="12" Foreground="#9FB0C8" />
            </StackPanel>

            <StackPanel Spacing="0">
              <TextBlock Text="BACKEND SERVER" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#9FB0C8" />
              <TextBox x:Name="BackendEntry" Classes="form-field" PlaceholderText="https://server.example.com" KeyDown="OnBackendKeyDown" />
            </StackPanel>

            <Button x:Name="ToggleButton" Classes="primary" Content="Start relay" Margin="0,6,0,0" Click="OnToggleClicked" />
            <TextBlock x:Name="ErrorText" IsVisible="False" Foreground="#FC8181" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Background="#111C2E" BorderBrush="#293750" BorderThickness="1" CornerRadius="16" Padding="18">
          <Grid ColumnDefinitions="12,*" ColumnSpacing="12">
            <Border x:Name="StatusDot" Width="12" Height="12" CornerRadius="6" Background="#9FB0C8" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="SERVICE STATUS" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Foreground="#9FB0C8" />
              <TextBlock x:Name="StatusText" Text="Stopped" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="BackendHostPanel" Background="#111C2E" BorderBrush="#293750" BorderThickness="1" CornerRadius="18" Padding="22">
          <StackPanel Spacing="16">
            <StackPanel Spacing="2">
              <TextBlock Text="HOST BACKEND" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="Host-only controls: choose the extracted backend folder, verify the address players can reach, then start the server." FontSize="12" Foreground="#9FB0C8" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="0">
              <TextBlock Text="BACKEND FOLDER" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#9FB0C8" />
              <Grid ColumnDefinitions="*,88" ColumnSpacing="8">
                <TextBox x:Name="HostFolderEntry" Classes="form-field" PlaceholderText="Select the extracted backend folder" TextChanged="OnHostConfigurationChanged" />
                <Button x:Name="BrowseBackendButton" Grid.Column="1" Classes="secondary" Content="Browse" VerticalAlignment="Bottom" Click="OnBrowseBackendFolder" />
              </Grid>
              <TextBlock Text="Choose the extracted backend folder, not the ZIP file. Windows needs Start-Backend.cmd; Linux and Steam Deck need ReVerse.Capture. The app makes it executable when possible." Margin="2,7,0,0" FontSize="11" Foreground="#9FB0C8" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="0">
              <TextBlock Text="ZEROTIER IPV4 ADDRESS" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#9FB0C8" />
              <Grid ColumnDefinitions="*,88" ColumnSpacing="8">
                <TextBox x:Name="ZeroTierAddressEntry" Classes="form-field" PlaceholderText="Detecting…" TextChanged="OnHostConfigurationChanged" />
                <Button x:Name="DetectAddressButton" Grid.Column="1" Classes="secondary" Content="Detect" VerticalAlignment="Bottom" Click="OnDetectAddress" />
              </Grid>
              <TextBlock Text="This is the host address on ZeroTier. Other players must be able to reach it; do not use 127.0.0.1. Detect checks ipconfig on Windows and ZeroTier network interfaces on Linux." Margin="2,7,0,0" FontSize="11" Foreground="#9FB0C8" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="0">
              <TextBlock Text="COMMAND" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#9FB0C8" />
              <TextBox x:Name="BackendCommandEntry" Classes="form-field" Height="132" AcceptsReturn="False" TextWrapping="Wrap" FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="12" TextChanged="OnBackendCommandChanged" />
              <TextBlock Text="Review before starting: Windows uses -PublicHost, -HttpUrl, and -Players. Linux uses the equivalent environment settings, including Matchmaking__Rulesets__match_master for the match size from 2 to 10." Margin="2,4,0,0" FontSize="11" Foreground="#9FB0C8" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="0">
              <TextBlock Text="PLAYER BACKEND URL" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#9FB0C8" />
              <Grid ColumnDefinitions="*,78" ColumnSpacing="8">
                <TextBox x:Name="PlayerBackendUrlEntry" Classes="form-field" Height="44" IsReadOnly="True" PlaceholderText="Detect ZeroTier to generate the URL" FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="12" />
                <Button x:Name="CopyBackendUrlButton" Grid.Column="1" Classes="secondary" Content="Copy" IsEnabled="False" VerticalAlignment="Bottom" Click="OnCopyBackendUrlClicked" />
              </Grid>
              <TextBlock Text="Copy this exact URL to every player. They paste it into the relay's Backend Server field. It must use the host's ZeroTier address, not localhost." Margin="2,7,0,0" FontSize="11" Foreground="#9FB0C8" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button x:Name="StartBackendButton" Classes="primary" Content="Start backend" Click="OnStartBackend" />
              <Button x:Name="StopBackendButton" Grid.Column="1" Classes="secondary" Content="Stop backend" IsEnabled="False" Click="OnStopBackend" />
            </Grid>
            <TextBlock Text="Start backend launches the process (and opens a separate command window on Windows). Keep this app open while playing; backend logs are written in the backend folder." FontSize="11" Foreground="#9FB0C8" TextWrapping="Wrap" />
            <TextBlock x:Name="BackendHostStatusText" Text="Backend stopped" FontSize="12" Foreground="#9FB0C8" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="8">
          <TextBlock Text="LAUNCH OPTIONS" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#9FB0C8" />
          <Grid ColumnDefinitions="*,78" ColumnSpacing="8">
            <Border Background="#17243A" BorderBrush="#293750" BorderThickness="1" CornerRadius="12" Padding="14,11">
              <TextBlock Text="/Rebe/HjmUriStr:http://127.0.0.1:5080" FontFamily="Consolas,DejaVu Sans Mono,monospace" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button x:Name="CopyButton" Grid.Column="1" Classes="secondary" Content="Copy" Click="OnCopyClicked" />
          </Grid>
          <TextBlock Text="Add this value to the application launch options, then start the relay before opening it." FontSize="12" Foreground="#9FB0C8" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="BusyOverlay" IsVisible="False" Background="#990B1220">
      <StackPanel Width="220" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Height="4" Foreground="#4FD1C5" />
        <TextBlock Text="Please wait…" HorizontalAlignment="Center" Foreground="#9FB0C8" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
