<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReVerse.Relay.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#090807" />
      <Setter Property="FontFamily" Value="Bahnschrift,DejaVu Sans" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#DED7CA" />
    </Style>
    <Style Selector=":is(TemplatedControl).form-field">
      <Setter Property="Height" Value="43" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,7,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="#161311" />
      <Setter Property="Foreground" Value="#DED7CA" />
      <Setter Property="BorderBrush" Value="#39322D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.form-field">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown.form-field">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(TemplatedControl).form-field:focus">
      <Setter Property="BorderBrush" Value="#C7212B" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="#8B8278" />
    </Style>
    <Style Selector="TextBlock.helper">
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#6F6760" />
    </Style>
    <Style Selector="Border.help">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#51483F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="ToolTip.ShowDelay" Value="50" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style Selector="TextBlock.help-glyph">
      <Setter Property="Foreground" Value="#8B8278" />
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Bahnschrift,DejaVu Sans" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="#98151D" />
      <Setter Property="Foreground" Value="#F2EADF" />
      <Setter Property="BorderBrush" Value="#C7212B" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Height" Value="43" />
      <Setter Property="Background" Value="#100E0D" />
      <Setter Property="Foreground" Value="#8B8278" />
      <Setter Property="BorderBrush" Value="#39322D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="ComboBox.language-selector">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="#100E0D" />
      <Setter Property="Foreground" Value="#8B8278" />
      <Setter Property="BorderBrush" Value="#39322D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontFamily" Value="Bahnschrift,DejaVu Sans" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="Height" Value="43" />
      <Setter Property="MinWidth" Value="70" />
      <Setter Property="Background" Value="#2A1012" />
      <Setter Property="Foreground" Value="#DED7CA" />
      <Setter Property="BorderBrush" Value="#98151D" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono" />
      <Setter Property="FontSize" Value="9" />
    </Style>
  </Application.Styles>
</Application>
